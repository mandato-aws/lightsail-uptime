{
  "name": "lightsail-uptime",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless uptime monitor that reboots a Lightsail instance when a website goes down",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "deploy-dci": "sam deploy --region us-east-1 --parameter-overrides AlertEmail=angelo@mandato.com WebsiteUrl=\"https://www.dcimotorsports.com/wp-signin/\" InstanceName=main-site-01",
    "local": "node --env-file-if-exists=.env src/local.mjs",
    "watch": "node --env-file-if-exists=.env src/local.mjs --watch",
    "test": "node --test \"test/**/*.test.mjs\"",
    "validate": "sam validate --lint"
  },
  "devDependencies": {
    "@aws-sdk/client-lightsail": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0"
  }
}
