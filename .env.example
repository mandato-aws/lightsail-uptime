# Copy to .env and fill in. .env is gitignored; this file is not.
#   cp .env.example .env
#   npm run local
#
# These are exactly the environment variables the deployed Lambda receives
# (SAM sets them from the template parameters), plus a few local-only ones at
# the bottom. Node reads this file natively via --env-file, so no dotenv.

# --- Required ---------------------------------------------------------------

WEBSITE_URL=https://example.com
INSTANCE_NAME=YourInstanceName

# --- Optional: check behaviour (defaults shown) ------------------------------

# Retries after the first failed check. 3 means 4 requests in total.
RETRY_COUNT=3

# Seconds to sleep between attempts.
RETRY_SLEEP_SECONDS=15

# Per-request timeout in seconds; a slower response counts as down.
REQUEST_TIMEOUT_SECONDS=10

# Minimum minutes between two reboots. 0 disables the cooldown guard.
COOLDOWN_MINUTES=15

# --- Optional: AWS wiring ----------------------------------------------------
# Both are empty by default. Leave them empty for a dry run: the cooldown is
# skipped and no alert is sent. Fill them in (with `sam deploy` outputs
# CooldownParameterName and AlertTopicArn) to exercise the real thing.

COOLDOWN_PARAMETER_NAME=
ALERT_TOPIC_ARN=

# --- Local only: not used by the deployed function ---------------------------

# Credentials/region for --reboot runs. AWS_REGION must match the region the
# Lightsail instance lives in.
AWS_REGION=us-east-1
# AWS_PROFILE=default

# Interval for `npm run local -- --watch`, mirroring CheckEveryMinutes.
CHECK_EVERY_MINUTES=5

# Set to 1 to make every run perform REAL reboot / SNS / SSM calls, the same as
# passing --reboot. Leave unset unless you mean it.
# LOCAL_ALLOW_REBOOT=0
